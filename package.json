{
  "name": "homepath-housing-risk-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "android:init": "sh -c 'if [ ! -d android ]; then npx cap add android; fi'",
    "cap:prepare": "node scripts/create-capacitor-web.mjs",
    "cap:sync": "npm run cap:prepare && npm run android:init && npx cap sync android",
    "android:debug-apk": "cd android && ./gradlew assembleDebug",
    "android:release-aab": "cd android && ./gradlew bundleRelease",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:ensure": "python3 scripts/ensure-sqlite-schema.py",
    "db:postgres:schema": "python3 scripts/create-postgres-prisma-schema.py",
    "db:postgres:validate": "npm run db:postgres:schema && DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/landlord_app_shadow prisma validate --schema prisma/schema.postgresql.prisma",
    "db:postgres:diff": "npm run db:postgres:schema && DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/landlord_app_shadow prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.postgresql.prisma --script > prisma/postgresql-migration.sql",
    "db:postgres:deploy": "npm run db:postgres:schema && prisma migrate deploy --schema prisma/schema.postgresql.prisma",
    "seed:public-data": "tsx prisma/seed-public-data.ts",
    "seed:legal-dong:file": "python3 scripts/import-legal-dong-sqlite.py data/legal-dong/legal-dong-code-full.txt",
    "seed:properties": "tsx scripts/seed-properties.ts",
    "smoke:address-flow": "tsx scripts/smoke-address-flow.ts",
    "check:public-apis": "tsx scripts/check-public-apis.ts",
    "probe:building-ledger": "tsx scripts/probe-building-ledger.ts",
    "probe:vworld-land": "tsx scripts/probe-vworld-land.ts",
    "record:demo": "tsx scripts/record-demo.ts",
    "create:demo-voiceover": "tsx scripts/create-demo-voiceover.ts",
    "ai:data:seed-long": "tsx scripts/seed-long-transactions.ts --from 202401 --to 202604 --lawd 27110,27140,27170,27200,27230,27260,27290,27710 --propertyTypes apartment --dealTypes trade,rent",
    "ai:transformer:export": "python3 scripts/ai/build_real_estate_feature_dataset.py --db-path prisma/dev.db --output-path artifacts/complex_monthly_features.csv",
    "ai:transformer:train": "python3 scripts/ai/real_estate_transformer_model.py --input-path artifacts/complex_monthly_features.csv --output-dir artifacts/model_outputs",
    "ai:transformer:train-long": "python3 scripts/ai/real_estate_transformer_model.py --input-path artifacts/complex_monthly_features.csv --output-dir artifacts/model_outputs --sequence-length 12 --horizon-months 3 --epochs 30 --num-layers 3 --d-model 96 --nhead 4 --dropout 0.15 --device cuda --checkpoint-every 1",
    "ai:gpu:check": "python3 -c \"import torch; print(torch.__version__, torch.version.cuda, torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'no-cuda')\"",
    "ai:upgrade": "npm run ai:data:seed-long && npm run ai:transformer:export && npm run ai:transformer:train-long",
    "rag:reindex": "tsx scripts/rag-reindex.ts",
    "rag:verify:qwen": "tsx scripts/verify-qwen-rag.ts",
    "rag:verify:turboquant": "tsx scripts/verify-turboquant-rag.ts",
    "llm:qwen:install": "python3 -m pip install --user --break-system-packages -r scripts/ai/requirements-local-qwen.txt",
    "llm:qwen:download": "python3 scripts/local_qwen_download.py",
    "llm:qwen:serve": "python3 scripts/local_qwen_server.py",
    "llm:qwen:serve:gtx1060": "scripts/ai/run-with-gtx1060-driver-libs.sh env CUDA_VISIBLE_DEVICES=0 LOCAL_QWEN_DEVICE=cuda LOCAL_QWEN_HOST=127.0.0.1 LOCAL_QWEN_PORT=11434 python3 scripts/local_qwen_server.py",
    "llm:qwen:serve:vllm": "bash scripts/ai/serve-qwen35-vllm.sh",
    "llm:qwen:serve:sglang": "bash scripts/ai/serve-qwen35-sglang.sh",
    "llm:qwen:smoke": "tsx scripts/local-qwen-smoke.ts",
    "ai:gpu:check:gtx1060": "scripts/ai/run-with-gtx1060-driver-libs.sh python3 -c \"import torch; print(torch.__version__, torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'no-cuda')\""
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@prisma/client": "^6.19.3",
    "fast-xml-parser": "^5.7.3",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
